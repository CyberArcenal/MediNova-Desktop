{
  "name": "medinova-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Aesthetic Clinic Management System - Desktop App for Admin and Staff (Electron + React + TypeScript)",
  "main": "src/main/index.js",
  "author": {
    "name": "CyberArcenal",
    "email": "cyberarcenal1@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberArcenal/medinova-desktop.git"
  },
  "build": {
    "appId": "com.medinova.desktop",
    "productName": "MediNova",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": "nsis",
      "artifactName": "MediNova-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "icons/icon.icns",
      "target": "dmg",
      "artifactName": "MediNova-${version}.${ext}"
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "MediNova-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "CyberArcenal",
      "repo": "medinova-desktop",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ]
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"vite\" \"tsc -w -p tsconfig.main.json\" \"electron ./src/main/index.js\"",
    "build": "vite build && electron-builder --publish never",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/react-datepicker": "^6.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.562.0",
    "node-cache": "^5.1.2",
    "react": "^19.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.78.0",
    "react-router-dom": "^7.12.0",
    "react-virtuoso": "^4.18.7",
    "react-window": "^2.2.7",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "express": "^5.2.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^8.0.3"
  }
}
